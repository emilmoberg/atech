# Kortets port. La stå tom for å finne kortet automatisk, ellers f.eks. /dev/cu.usbmodem1101
SERIAL_PORT=
# Kortets enhets-ID
DEVICE_ID=

# Webappens mottak, og samme hemmelighet som INGEST_TOKEN i web/.env.local
INGEST_URL=http://localhost:3100/api/clips
INGEST_TOKEN=

# Ferdige klipp ligger her til webappen har tatt imot dem
SPOOL_DIR=spool
